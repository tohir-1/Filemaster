# Telegram Bot Token from @BotFather
BOT_TOKEN=your_bot_token_here

# Admin Telegram User ID (get from @userinfobot)
ADMIN_ID=123456789

# Bot username without @
BOT_USERNAME=FileMasterBot

# Max file size in MB (Telegram limit is ~20MB for bots in most cases)
MAX_FILE_SIZE_MB=20

# SQLite database path
DATABASE_PATH=./database.sqlite

# Optional: Ghostscript path if not in PATH (for PDF compression)
# GHOSTSCRIPT_PATH=gs
